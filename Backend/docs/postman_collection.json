          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/delete-account",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "delete-account"
              ]
            }
          }
