    },
    {
      "name": "Ranking",
      "item": [
        {
          "name": "Get Leaderboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/rankings/leaderboard?type=xp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "rankings",
                "leaderboard"
              ],
              "query": [
                {
                  "key": "type",
                  "value": "xp",
                  "description": "Can be 'xp', 'volts', 'wins', or 'netRunRate'"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
