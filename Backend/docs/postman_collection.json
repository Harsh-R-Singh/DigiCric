        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/profile/:username",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "profile",
                ":username"
              ],
              "variable": [
                {
                  "key": "username",
                  "value": "testuser"
                }
              ]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/current-user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "current-user"
              ]
            }
          }
        },
        {
          "name": "Update User Stats",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"winner\": true,\n    \"loses\": false,\n    \"draws\": false,\n    \"volts\": 150,\n    \"userScore\": 120,\n    \"runsConceded\": 100,\n    \"wicketsTaken\": 5,\n    \"netRunRate\": 1.25,\n    \"xp\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/update-stats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
